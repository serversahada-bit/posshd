# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/uploads/*
!/public/uploads/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database dump (contains real customer/activity data)
/pos.sql

# script with hardcoded real API key
/test-full.js

# stray leftover build cache (no real source)
/pos-app
.next-dev.log

# real courier reconciliation sample files (contain real customer PII)
/JNE Rekon.xlsx
/JNT Rekon.xls
/Ninja Rekons.xlsx
/POS Rekon.xlsx
